        "custom_liquid": "<div class=\"ht-crt is-loading\" data-crt>\n  <div class=\"ht-crt__inner\">\n    <div class=\"ht-crt__screen\">\n      <video class=\"ht-crt__video\"\n             autoplay muted loop playsinline preload=\"auto\"\n             poster=\"{{ 'crt-poster.jpg' | asset_url }}\">\n        <source src=\"https://cdn.shopify.com/videos/c/o/v/89c2b1a76bdf45bc8636ab0c0d54d1bf.mp4\">\n      </video>\n\n      <div class=\"ht-crt__scanlines\" aria-hidden=\"true\"></div>\n      <div class=\"ht-crt__glass\" aria-hidden=\"true\"></div>\n      <div class=\"ht-crt__flash\" aria-hidden=\"true\"></div>\n    </div>\n\n    <img class=\"ht-crt__frame\"\n         src=\"{{ 'crt-frame-transparent.png' | asset_url }}\"\n         alt=\"Vintage CRT television\"\n         loading=\"eager\" decoding=\"async\" fetchpriority=\"high\">\n  </div>\n</div>\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  document.querySelectorAll('[data-crt]').forEach(function(crt){\n    const video = crt.querySelector('video');\n    const ready = () => {\n      crt.classList.remove('is-loading');\n      crt.classList.add('is-ready');\n    };\n\n    // Already buffered enough?\n    if (video && video.readyState >= 2) { ready(); return; }\n\n    // Otherwise wait for the earliest usable event\n    if (video){\n      video.addEventListener('loadeddata', ready, { once: true });\n      video.addEventListener('canplay',     ready, { once: true });\n      // Fallback timeout (slow networks): reveal after 2.5s so the page doesn't look broken\n      setTimeout(ready, 2500);\n    }\n  });\n});\n</script>",
