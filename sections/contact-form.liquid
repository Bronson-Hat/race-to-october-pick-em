<section class="ht-contact" data-contact-desk>
  <div class="ht-contact__ticker" aria-hidden="true">
    <div><span>Correspondence desk</span><i>◆</i><span>Brooklyn, New York</span><i>◆</i><span>Order help</span><i>◆</i><span>Wholesale</span><i>◆</i><span>Press & projects</span><i>◆</i><span>Correspondence desk</span><i>◆</i><span>Brooklyn, New York</span><i>◆</i><span>Order help</span><i>◆</i><span>Wholesale</span><i>◆</i><span>Press & projects</span></div>
  </div>

  <header class="ht-contact__hero">
    <div>
      <p class="ht-contact__kicker">Hat Trick Communications Office · Official Issue</p>
      <h1>Drop us<br><em>a line.</em></h1>
    </div>
    <div class="ht-contact__intro">
      <span class="ht-contact__stamp">Routing desk<br>Brooklyn, NY</span>
      <p>Questions, order help, wholesale inquiries, press, collaborations, or a very specific hat memory—we’re listening.</p>
    </div>
  </header>

  <div class="ht-contact__routes" aria-label="Contact inquiry categories">
    <div><span>01</span><strong>Order help</strong><p>Include your order number so we can find it fast.</p></div>
    <div><span>02</span><strong>Wholesale</strong><p>Tell us about your shop, city, and what caught your eye.</p></div>
    <div><span>03</span><strong>Everything else</strong><p>Press, projects, ideas, stories, and general clubhouse business.</p></div>
  </div>

  <div class="ht-contact__desk">
    <aside class="ht-contact__side">
      <p>Incoming mail</p>
      <h2>Send it to the clubhouse.</h2>
      <div class="ht-contact__note">
        <span>Before sending</span>
        <ul>
          <li>Add an order number when relevant.</li>
          <li>Use the email where we can reach you.</li>
          <li>Give us the useful details—the weird ones too.</li>
        </ul>
      </div>
      <div class="ht-contact__meter" aria-hidden="true"><i></i><span>Mailroom open</span></div>
    </aside>

    <div class="ht-contact__form-card">
      <div class="ht-contact__form-head"><span>Form HT–NYC–01</span><strong>Official correspondence</strong></div>

      {%- form 'contact', id: 'ContactForm', class: 'ht-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="ht-contact__success" tabindex="-1" autofocus>
            <strong>Message received.</strong>
            <p>Your note made it to the clubhouse.</p>
          </div>
        {%- elsif form.errors -%}
          <div class="ht-contact__errors" role="alert" tabindex="-1" autofocus>
            <strong>Check the form and try again.</strong>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <label class="ht-contact__field ht-contact__field--wide">
          <span>Route this to</span>
          <select name="contact[Inquiry type]">
            <option value="General clubhouse business">General clubhouse business</option>
            <option value="Order help">Order help</option>
            <option value="Wholesale">Wholesale</option>
            <option value="Press or collaboration">Press or collaboration</option>
          </select>
        </label>

        <label class="ht-contact__field">
          <span>Name</span>
          <input autocomplete="name" type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="YOUR NAME">
        </label>

        <label class="ht-contact__field">
          <span>Email <b>Required</b></span>
          <input autocomplete="email" type="email" id="ContactForm-email" name="contact[email]" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" aria-required="true" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %} placeholder="EMAIL ADDRESS" required>
        </label>

        <label class="ht-contact__field ht-contact__field--wide">
          <span>Phone <b>Optional</b></span>
          <input type="tel" id="ContactForm-phone" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="[0-9\-+(). ]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="PHONE NUMBER">
        </label>

        <label class="ht-contact__field ht-contact__field--wide">
          <span>Message</span>
          <textarea rows="7" id="ContactForm-body" name="contact[{{ 'templates.contact.form.comment' | t }}]" placeholder="WHAT'S GOING ON?">{{- form.body -}}</textarea>
        </label>

        <button class="ht-contact__submit" type="submit"><span>Send to Hat Trick</span><b>↗</b></button>
      {%- endform -%}
    </div>
  </div>

  <footer class="ht-contact__footer" aria-hidden="true"><span>Filed in Brooklyn</span><i>◆</i><span>Hat Trick NYC</span><i>◆</i><span>Clubhouse communications</span></footer>
</section>

<style>
  #shopify-section-{{ section.id }}{background:#e9e2cb;color:#171916}
  .ht-contact{--ink:#171916;--paper:#e9e2cb;--red:#c93829;--blue:#214c73;--yellow:#efb929;--green:#285a3b;overflow:hidden;background-color:var(--paper);background-image:linear-gradient(rgba(23,25,22,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(23,25,22,.055) 1px,transparent 1px);background-size:22px 22px;border-block:6px solid var(--ink);font-family:Arial,sans-serif}
  .ht-contact__ticker{overflow:hidden;border-bottom:4px solid var(--ink);background:var(--ink);color:var(--paper)}.ht-contact__ticker div{display:flex;width:max-content;align-items:center;gap:27px;padding:13px 0;animation:htContactTicker 28s linear infinite}.ht-contact__ticker span{text-transform:uppercase;letter-spacing:.17em;font:900 9px/1 Arial,sans-serif}.ht-contact__ticker i{color:var(--yellow);font-style:normal}@keyframes htContactTicker{to{transform:translateX(-50%)}}
  .ht-contact__hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr);gap:clamp(40px,8vw,120px);align-items:end;padding:clamp(70px,10vw,145px) clamp(22px,7vw,105px) clamp(65px,8vw,115px)}.ht-contact__kicker{margin:0 0 26px;color:var(--red);text-transform:uppercase;letter-spacing:.18em;font:900 10px/1 Arial,sans-serif}.ht-contact__hero h1{margin:0;text-transform:uppercase;letter-spacing:-.045em;font:900 clamp(82px,12vw,180px)/.7 Impact,Arial Black,sans-serif}.ht-contact__hero h1 em{color:var(--blue);font-size:.78em;font-style:normal}.ht-contact__intro{position:relative;padding:34px;border:4px solid var(--ink);background:#f5efdc;box-shadow:12px 12px 0 var(--green);transform:rotate(1deg)}.ht-contact__intro p{margin:25px 0 0;font:800 clamp(17px,1.6vw,23px)/1.45 Arial,sans-serif}.ht-contact__stamp{display:inline-block;padding:11px 14px;border:3px solid var(--red);color:var(--red);text-align:center;text-transform:uppercase;letter-spacing:.14em;font:900 8px/1.25 Arial,sans-serif;transform:rotate(-4deg)}
  .ht-contact__routes{display:grid;grid-template-columns:repeat(3,1fr);margin:0 clamp(22px,7vw,105px);border:4px solid var(--ink);background:#c9c1aa;box-shadow:11px 11px 0 var(--yellow)}.ht-contact__routes>div{padding:26px;border-right:3px solid var(--ink)}.ht-contact__routes>div:last-child{border:0}.ht-contact__routes span{display:block;margin-bottom:34px;color:var(--red);font:900 40px/1 Impact,Arial Black,sans-serif}.ht-contact__routes strong{display:block;text-transform:uppercase;font:900 19px/1 Arial Black,Arial,sans-serif}.ht-contact__routes p{margin:10px 0 0;font:700 12px/1.45 Arial,sans-serif}
  .ht-contact__desk{display:grid;grid-template-columns:minmax(290px,.7fr) minmax(0,1.3fr);gap:clamp(35px,7vw,105px);padding:clamp(80px,11vw,155px) clamp(22px,7vw,105px)}.ht-contact__side>p{margin:0 0 18px;color:var(--green);text-transform:uppercase;letter-spacing:.16em;font:900 9px/1 Arial,sans-serif}.ht-contact__side h2{max-width:600px;margin:0 0 48px;text-transform:uppercase;letter-spacing:-.035em;font:900 clamp(55px,7vw,105px)/.77 Impact,Arial Black,sans-serif}.ht-contact__note{padding:25px;border:4px solid var(--ink);background:var(--yellow);box-shadow:9px 9px 0 var(--blue);transform:rotate(-1deg)}.ht-contact__note span{display:block;margin-bottom:18px;padding-bottom:11px;border-bottom:3px solid var(--ink);text-transform:uppercase;letter-spacing:.13em;font:900 9px/1 Arial,sans-serif}.ht-contact__note ul{margin:0;padding-left:18px;font:800 13px/1.65 Arial,sans-serif}.ht-contact__meter{display:flex;align-items:center;gap:12px;margin-top:34px;text-transform:uppercase;letter-spacing:.13em;font:900 9px/1 Arial,sans-serif}.ht-contact__meter i{width:16px;height:16px;border:3px solid var(--ink);border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(40,90,59,.15);animation:htContactPulse 2.2s ease-in-out infinite}@keyframes htContactPulse{50%{box-shadow:0 0 0 11px rgba(40,90,59,0)}}
  .ht-contact__form-card{border:5px solid var(--ink);background:#f5efdc;box-shadow:14px 14px 0 var(--red)}.ht-contact__form-head{display:flex;justify-content:space-between;gap:20px;padding:17px 20px;border-bottom:4px solid var(--ink);background:var(--blue);color:var(--paper);text-transform:uppercase;letter-spacing:.14em;font:900 8px/1 Arial,sans-serif}.ht-contact__form{display:grid;grid-template-columns:1fr 1fr;gap:0;padding:clamp(25px,4vw,50px)}.ht-contact__field{display:grid;gap:10px;padding:0 13px 26px}.ht-contact__field--wide{grid-column:1/-1}.ht-contact__field>span{display:flex;justify-content:space-between;text-transform:uppercase;letter-spacing:.13em;font:900 8px/1 Arial,sans-serif}.ht-contact__field b{color:var(--red);font-size:7px}.ht-contact__field input,.ht-contact__field textarea,.ht-contact__field select{width:100%;min-height:58px;box-sizing:border-box;padding:16px;border:3px solid var(--ink);border-radius:0;background:var(--paper);color:var(--ink);box-shadow:5px 5px 0 var(--yellow);font:800 16px/1.3 Arial,sans-serif;-webkit-text-fill-color:var(--ink);appearance:none}.ht-contact__field textarea{min-height:180px;resize:vertical}.ht-contact__field select{background-image:linear-gradient(45deg,transparent 50%,var(--ink) 50%),linear-gradient(135deg,var(--ink) 50%,transparent 50%);background-position:calc(100% - 21px) 25px,calc(100% - 15px) 25px;background-size:6px 6px;background-repeat:no-repeat}.ht-contact__field input:focus,.ht-contact__field textarea:focus,.ht-contact__field select:focus{outline:4px solid var(--blue);outline-offset:2px}.ht-contact__submit{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;margin:10px 13px 0;padding:19px 21px;border:3px solid var(--ink);border-radius:0;background:var(--green);color:var(--paper);box-shadow:7px 7px 0 var(--ink);text-transform:uppercase;letter-spacing:.13em;font:900 10px/1 Arial,sans-serif}.ht-contact__submit b{font-size:18px}.ht-contact__success,.ht-contact__errors{grid-column:1/-1;margin:0 13px 28px;padding:20px;border:3px solid var(--ink);background:var(--yellow)}.ht-contact__success strong,.ht-contact__errors strong{display:block;text-transform:uppercase;font:900 17px/1 Arial Black,Arial,sans-serif}.ht-contact__success p{margin:8px 0 0;font:700 12px/1.4 Arial,sans-serif}
  .ht-contact__footer{display:flex;justify-content:center;gap:25px;padding:20px;border-top:5px solid var(--ink);background:var(--ink);color:var(--paper);text-transform:uppercase;letter-spacing:.15em;font:900 9px/1 Arial,sans-serif}.ht-contact__footer i{color:var(--yellow);font-style:normal}
  @media(max-width:900px){.ht-contact__hero,.ht-contact__desk{grid-template-columns:1fr}.ht-contact__intro{max-width:620px}.ht-contact__routes{grid-template-columns:1fr}.ht-contact__routes>div{border-right:0;border-bottom:3px solid var(--ink)}.ht-contact__routes>div:last-child{border-bottom:0}.ht-contact__routes span{margin-bottom:15px}.ht-contact__side{max-width:650px}}
  @media(max-width:560px){.ht-contact__hero h1{font-size:72px}.ht-contact__hero,.ht-contact__desk{padding-inline:16px}.ht-contact__routes{margin-inline:16px}.ht-contact__intro{padding:25px}.ht-contact__form{grid-template-columns:1fr;padding:22px 10px 30px}.ht-contact__field{grid-column:1/-1;padding-inline:9px}.ht-contact__field input,.ht-contact__field textarea,.ht-contact__field select{font-size:16px}.ht-contact__submit{margin-inline:9px}.ht-contact__form-head{display:grid}.ht-contact__footer{flex-wrap:wrap;gap:12px;font-size:7px}}
  @media(prefers-reduced-motion:reduce){.ht-contact__ticker div,.ht-contact__meter i{animation:none}}
@media(min-width:901px){.ht-contact__side h2{font-size:clamp(46px,4.5vw,72px);line-height:.92;word-break:normal;overflow-wrap:normal;hyphens:none}}
</style>

{% schema %}
{"name":"Hat Trick contact desk","settings":[],"presets":[{"name":"Hat Trick contact desk"}]}
{% endschema %}
