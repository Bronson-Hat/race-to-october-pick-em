(()=>{const root=document.querySelector('[data-legal-department]:not([data-legal-ready])');if(!root)return;root.setAttribute('data-legal-ready','');const parts=new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',year:'numeric',month:'numeric',day:'numeric'}).formatToParts(new Date()).reduce((date,part)=>{if(part.type!=='literal')date[part.type]=Number(part.value);return date},{});const today=Date.UTC(parts.year,parts.month-1,parts.day);const last=Date.UTC(2026,5,19);const days=Math.max(0,Math.floor((today-last)/86400000));const out=root.querySelector('[data-legal-days]');if(out)out.textContent=String(days).padStart(3,'0')})();
