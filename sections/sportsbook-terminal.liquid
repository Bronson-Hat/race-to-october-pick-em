<script>
(() => {
  const root = document.querySelector('[data-ht-otb]'); if (!root || root.dataset.ready) return; root.dataset.ready = 'true';
  const api = root.dataset.endpoint; const gamesNode = root.querySelector('[data-games]'); const status = root.querySelector('[data-status]');
  const dateInput = root.querySelector('[data-date]'); const balance = root.querySelector('[data-balance]'); const ticketsNode = root.querySelector('[data-tickets]'); const pickRecordNode = root.querySelector('[data-pick-record]'); const activeCountNode = root.querySelector('[data-active-count]'); const picksPanel = root.querySelector('[data-picks-panel]');
  const boardNav = root.querySelector('[data-board-nav]'); const refreshButton = root.querySelector('[data-refresh]'); const filters = root.querySelector('[data-filters]');
  const review = root.querySelector('[data-review]'); const reviewSummary = root.querySelector('[data-review-summary]'); const reviewError = root.querySelector('[data-review-error]'); const reviewConfirm = root.querySelector('[data-review-confirm]');
  const mobileBar = root.querySelector('[data-mobile-bar]'); const mobileBalance = root.querySelector('[data-mobile-balance]'); const mobileActive = root.querySelector('[data-mobile-active]'); const picksDrawer = root.querySelector('[data-picks-drawer]');
  const signedOut = root.querySelector('[data-signed-out]'); const signedIn = root.querySelector('[data-signed-in]');
  const profile = root.querySelector('[data-profile]');
  const eligibilityForm = root.querySelector('[data-eligibility]');
  const refillBox = root.querySelector('[data-refill]'); const refillButton = root.querySelector('[data-refill-button]');
  const leaderboardNode = root.querySelector('[data-leaderboard]'); const myRankNode = root.querySelector('[data-my-rank]');
  const sessionKey = 'ht_off_track_session'; let session = localStorage.getItem(sessionKey) || ''; let eligibilityConfirmed = false; let lastState = null; let allGames = []; let activeFilter = 'open'; let pendingReview = null; let reviewTrigger = null; const gameMap = new Map();
  const chicagoToday=()=>new Intl.DateTimeFormat('en-CA',{timeZone:'America/Chicago'}).format(new Date()); let lastChicagoDay=chicagoToday(); dateInput.value=lastChicagoDay;
  if(matchMedia('(max-width:749px)').matches)picksPanel.open=false;
  const loginReturnUrl = new URL(location.href);
  loginReturnUrl.hash = '';
  if ((root.dataset.themeRole || '').toLowerCase() !== 'main') {
    loginReturnUrl.searchParams.set('preview_theme_id', root.dataset.themeId || '189244801320');
  } else {
    loginReturnUrl.searchParams.delete('preview_theme_id');
  }
  root.querySelector('[data-login]').href = api + '/auth/start?return=' + encodeURIComponent(loginReturnUrl.toString());
  const call = async (path, options={}) => { options.headers = {...(options.headers||{})}; if(session) options.headers.Authorization='Bearer '+session; let response; try{response=await fetch(api + path,options);}catch{const error=new Error('You appear to be offline. Check your connection and try again.');error.status=0;throw error;} let data={};try{data=await response.json();}catch{} if (!response.ok) { const error=new Error(data.error || (response.status===401?'Your session expired. Please sign in again.':'The Pick ’Em desk could not complete that request.')); error.status=response.status; throw error; } return data; };
  function announce(message){ status.textContent = message; }
  function fmtTime(value){ return new Intl.DateTimeFormat([], {hour:'numeric',minute:'2-digit'}).format(new Date(value)); }
  function renderSignedOutBoard(){allGames=[];gameMap.clear();boardNav.hidden=true;gamesNode.innerHTML='<div class="ht-otb__score-gate"><strong>SIGN IN TO OPEN THE GAME BOARD</strong><span>The public preview is the top-ten pennant board below. Continue with Shop to see games, make picks, and keep your Hat Bucks attached to your account.</span></div>';announce('Sign in with Shop to open the game board.');}
  function renderLoading(){gamesNode.innerHTML='<div class="ht-otb__skeleton" aria-hidden="true"></div><div class="ht-otb__skeleton" aria-hidden="true"></div>';}
  function gameMatchesFilter(game){const state=String(game.state||'').toLowerCase();if(activeFilter==='open')return Boolean(game.wageringOpen);if(activeFilter==='live')return state==='live';if(activeFilter==='final')return state==='final'||state==='completed';return true;}
  function applyFilter(){let visible=0;root.querySelectorAll('.ht-game').forEach(card=>{const game=gameMap.get(Number(card.dataset.gameId));const show=Boolean(game&&gameMatchesFilter(game));card.hidden=!show;if(show)visible++;});root.querySelector('[data-filter-empty]')?.remove();if(!visible&&allGames.length){gamesNode.insertAdjacentHTML('beforeend',`<p class="ht-otb__empty-state" data-filter-empty>No ${activeFilter==='all'?'games':activeFilter+' games'} on this date. Try another filter or day.</p>`);}filters.querySelectorAll('[data-filter]').forEach(button=>{const selected=button.dataset.filter===activeFilter;button.classList.toggle('is-active',selected);button.setAttribute('aria-pressed',String(selected));});}
  async function loadGames({silent=false}={}){ if(!session){renderSignedOutBoard();return;} boardNav.hidden=false;if(!silent){renderLoading();announce('Updating the Pick ’Em board…');}refreshButton.disabled=true;try { const data = await call('/games?date='+encodeURIComponent(dateInput.value)); renderGames(data.games||[]); const stamp=data.updatedAt?new Date(data.updatedAt).toLocaleTimeString([], {hour:'numeric',minute:'2-digit'}):'just now';announce(data.stale ? `Showing delayed scores last updated ${stamp}. New picks are paused.` : `Board updated ${stamp}.`); } catch(error){if(!silent)gamesNode.innerHTML=`<div class="ht-otb__score-gate"><strong>SCOREBOARD SIGNAL TEMPORARILY LOST</strong><span>${escapeHtml(error.message)} Your submitted picks remain safe. Use Refresh to try again.</span></div>`; announce(error.message); } finally{refreshButton.disabled=false;} }
  function renderGames(games){ allGames=games;gamesNode.innerHTML=''; gameMap.clear(); games.forEach(game=>gameMap.set(Number(game.id),game)); if(!games.length){ gamesNode.innerHTML='<p class="ht-otb__empty-state">No games are scheduled on this date. Try the previous or next day.</p>'; renderTickets(); return; } games.forEach(game => { const node=root.querySelector('[data-game-template]').content.cloneNode(true); const card=node.querySelector('.ht-game'); card.dataset.gameId=game.id; card.querySelector('[data-game-status]').textContent=game.state==='live' ? `${game.inningState || 'LIVE'} ${game.inning || ''}` : game.status; card.querySelector('[data-game-time]').textContent=game.state==='scheduled'?fmtTime(game.start):String(game.state||'').toUpperCase(); ['away','home'].forEach(side=>{card.querySelector(`[data-${side}-abbr]`).textContent=game[side].abbreviation;card.querySelector(`[data-${side}-name]`).textContent=game[side].displayName||game[side].name;card.querySelector(`[data-${side}-record]`).textContent=game[side].record;card.querySelector(`[data-${side}-score]`).textContent=game[side].score??'–';}); card.querySelector('[data-pick="away"]').textContent=`${game.away.abbreviation} · RETURN ×${Number(game.lines.away).toFixed(2)}`; card.querySelector('[data-pick="home"]').textContent=`${game.home.abbreviation} · RETURN ×${Number(game.lines.home).toFixed(2)}`; if(!game.wageringOpen) card.classList.add('is-locked'); wireCard(card,game); gamesNode.appendChild(node); }); applyFilter();markExistingPicks(); renderTickets(); }
  function markExistingPicks(){root.querySelectorAll('.ht-game button.is-your-pick').forEach(button=>button.classList.remove('is-your-pick'));root.querySelectorAll('.ht-game .is-your-pick-team').forEach(team=>team.classList.remove('is-your-pick-team'));root.querySelectorAll('.ht-game').forEach(card=>{card.classList.remove('pick-result--won','pick-result--lost');const result=card.querySelector('[data-pick-result]');if(result){result.hidden=true;result.className='ht-game__result';result.textContent='';}});if(!lastState?.tickets)return;lastState.tickets.forEach(ticket=>{const card=root.querySelector(`.ht-game[data-game-id="${CSS.escape(String(ticket.gameId))}"]`);const selection=CSS.escape(String(ticket.selection));card?.querySelector(`[data-pick="${selection}"]`)?.classList.add('is-your-pick');card?.querySelector(`[data-team="${selection}"]`)?.classList.add('is-your-pick-team');const ticketStatus=String(ticket.status||'').toLowerCase();if(card&&(ticketStatus==='won'||ticketStatus==='lost')){const result=card.querySelector('[data-pick-result]');card.classList.add(`pick-result--${ticketStatus}`);result.classList.add(ticketStatus);result.textContent=ticketStatus==='won'?'YOU WON':'YOU LOST';result.hidden=false;}});}
  function openReview(card,game,selection,stake){const selected=game[selection];const stakeValue=stake==='ALL_IN'?Number(lastState?.balance||0):Number(stake);const multiplier=Number(game.lines[selection]);const estimated=Math.floor(stakeValue*multiplier);pendingReview={card,game,market:'winner',selection,stake};reviewTrigger=card.querySelector('[data-submit]');reviewError.hidden=true;reviewError.textContent='';reviewSummary.innerHTML=`<dt>MATCHUP</dt><dd>${escapeHtml(game.away.displayName||game.away.name)} at ${escapeHtml(game.home.displayName||game.home.name)}</dd><dt>YOUR PICK</dt><dd>${escapeHtml(selected.displayName||selected.name)}</dd><dt>RISK</dt><dd>${stakeValue.toLocaleString()} HAT BUCKS</dd><dt>RETURN</dt><dd>×${multiplier.toFixed(2)}</dd><dt>ESTIMATED TOTAL</dt><dd>${estimated.toLocaleString()} HAT BUCKS</dd><dt>LOCKS</dt><dd>${escapeHtml(fmtTime(game.start))} · FIRST PITCH</dd>`;review.showModal();}
  function wireCard(card,game){ let market='',selection='',stake=''; card.querySelectorAll('[data-pick]').forEach(button=>button.addEventListener('click',()=>{ market='winner'; selection=button.dataset.pick; card.querySelectorAll('[data-pick]').forEach(b=>b.classList.toggle('is-selected',b===button)); ready(); })); card.querySelectorAll('[data-stake]').forEach(button=>button.addEventListener('click',()=>{stake=button.dataset.stake;card.querySelectorAll('[data-stake]').forEach(b=>b.classList.toggle('is-selected',b===button));ready();})); const submit=card.querySelector('[data-submit]'); const ready=()=>{submit.disabled=!(market&&stake&&session&&eligibilityConfirmed&&game.wageringOpen);submit.textContent='REVIEW PICK';}; submit.htReady=ready; submit.addEventListener('click',()=>openReview(card,game,selection,stake)); }
  async function confirmReviewedPick(){if(!pendingReview||reviewConfirm.disabled)return;const {card,game,market,selection,stake}=pendingReview;reviewConfirm.disabled=true;reviewConfirm.textContent='PRINTING PICK…';reviewError.hidden=true;try{const state=await call('/wagers',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({gameId:game.id,market,selection,stake})});renderState(state);card.classList.add('is-locked');card.querySelector('[data-submit]').textContent='PICK ACCEPTED';announce('Pick accepted and added to your entry slips.');review.close('confirmed');pendingReview=null;loadLeaderboard();}catch(error){reviewError.textContent=error.message;reviewError.hidden=false;announce(error.message);}finally{reviewConfirm.disabled=false;reviewConfirm.textContent='CONFIRM PICK';}}
  async function loadState(){ if(!session){renderSignedOut();return;} try{renderState(await call('/state'));}catch(error){if(error.status===401){localStorage.removeItem(sessionKey);session='';renderSignedOut();}announce(error.message);} }
  function closeMobilePicks(){picksDrawer.classList.remove('is-mobile-open');mobileBar.setAttribute('aria-expanded','false');}
  function renderSignedOut(){ eligibilityConfirmed=false;lastState=null;signedOut.hidden=false;signedIn.hidden=true;profile.hidden=true;eligibilityForm.hidden=true;picksDrawer.hidden=true;mobileBar.hidden=true;root.classList.remove('has-mobile-bar');closeMobilePicks();ticketsNode.innerHTML='';root.querySelectorAll('[data-submit]').forEach(button=>button.disabled=true);renderSignedOutBoard(); }
  function renderState(state){ lastState=state;eligibilityConfirmed=!state.eligibilityRequired;signedOut.hidden=true;signedIn.hidden=false;picksDrawer.hidden=false;boardNav.hidden=false;balance.textContent=Number(state.balance).toLocaleString();mobileBalance.textContent=Number(state.balance).toLocaleString();mobileBar.hidden=false;root.classList.add('has-mobile-bar');refillBox.hidden=!state.refillEligible;eligibilityForm.hidden=eligibilityConfirmed;root.querySelector('[data-player-name]').textContent=state.nickname||'UNNAMED RUNNER';root.querySelector('[data-player-rank]').textContent=state.rank?`RANK ${state.rank.rank} · ${state.winningPicks}/${state.settledPicks} CORRECT`:'';profile.hidden=!state.nicknameRequired;markExistingPicks();renderTickets();root.querySelectorAll('[data-submit]').forEach(button=>button.htReady?.()); }
  function renderTickets(){if(!lastState)return;const pending=lastState.tickets.filter(ticket=>ticket.status==='pending'),settled=lastState.tickets.filter(ticket=>ticket.status!=='pending'),recent=settled.slice(0,3),history=settled.slice(3);activeCountNode.textContent=`${pending.length} ACTIVE`;mobileActive.textContent=`${pending.length} ACTIVE`;const wins=Number(lastState.winningPicks)||0,total=Number(lastState.settledPicks)||0,losses=Math.max(0,total-wins),accuracy=total?Math.round(wins/total*100):0;pickRecordNode.textContent=total?`${wins}–${losses} RECORD · ${accuracy}% CORRECT · ${pending.length} ACTIVE`:`NO SETTLED PICKS · ${pending.length} ACTIVE`;ticketsNode.innerHTML='';const slip=ticket=>{const game=gameMap.get(Number(ticket.gameId)),away=game?(game.away.displayName||game.away.name):'',home=game?(game.home.displayName||game.home.name):'',matchup=game?`${away} at ${home}`:`MLB GAME ${ticket.gameId}`,selected=game?.[ticket.selection],picked=selected?(selected.displayName||selected.name):String(ticket.selection).toUpperCase(),node=document.createElement('article');node.className='ht-slip';node.innerHTML=`<small>WINDOW 01 · GAME ${ticket.gameId}</small><b>${escapeHtml(matchup)}</b><span>YOUR PICK · <strong>${escapeHtml(picked)}</strong></span><span>RISK · ${ticket.stake} HAT BUCKS</span><span>TOTAL POTENTIAL RETURN · ${ticket.quotedPayout} HAT BUCKS</span><strong class="${ticket.status}">${String(ticket.status).toUpperCase()}</strong>${ticket.result?`<small>${escapeHtml(ticket.result)}</small>`:''}`;return node;};const group=(title,items)=>{if(!items.length)return;const wrap=document.createElement('section');wrap.className='ht-ticket-group';wrap.innerHTML=`<h3>${title}</h3>`;items.forEach(ticket=>wrap.appendChild(slip(ticket)));ticketsNode.appendChild(wrap);};group('ACTIVE PICKS',pending);group('RECENT RESULTS',recent);if(history.length){const archive=document.createElement('details');archive.className='ht-ticket-history';archive.innerHTML=`<summary>VIEW FULL PICK HISTORY · ${history.length} MORE</summary><div></div>`;history.forEach(ticket=>archive.lastElementChild.appendChild(slip(ticket)));ticketsNode.appendChild(archive);}if(!lastState.tickets.length)ticketsNode.innerHTML='<p class="ht-otb__empty">No picks submitted yet.</p>';}
  async function exchangeFragment(){const match=location.hash.match(/(?:^#|&)auth=([^&]+)/);if(!match)return;history.replaceState(null,'',location.pathname+location.search);try{const data=await call('/auth/exchange',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:decodeURIComponent(match[1])})});session=data.token;localStorage.setItem(sessionKey,session);announce('Shop account verified. Welcome to the Race to October.');}catch(error){announce(error.message);}}
  profile.addEventListener('submit',async event=>{event.preventDefault();try{renderState(await call('/profile',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nickname:new FormData(profile).get('nickname')})}));announce('Your race name is on the board.');loadLeaderboard();}catch(error){announce(error.message);}});
  eligibilityForm.addEventListener('submit',async event=>{event.preventDefault();const button=eligibilityForm.querySelector('button');button.disabled=true;button.textContent='RECORDING CONFIRMATION…';try{const state=await call('/eligibility',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({confirmed:new FormData(eligibilityForm).get('confirmed')==='on',rulesVersion:'2026-08-27-pick-em-final-1'})});renderState(state);announce('Eligibility, Official Rules, and Privacy Policy acceptance recorded. You may now make picks.');}catch(error){announce(error.message);button.disabled=false;button.textContent='CONFIRM & ENTER PICK ’EM';}});
  refillButton.addEventListener('click',async()=>{refillButton.disabled=true;refillButton.textContent='OPENING CLUBHOUSE…';try{renderState(await call('/refill',{method:'POST'}));announce('Daily clubhouse refill applied. Your balance is now 25 Hat Bucks.');loadLeaderboard();}catch(error){announce(error.message);refillButton.textContent=error.message;setTimeout(()=>{refillButton.disabled=false;refillButton.textContent='CLAIM 25-POINT FLOOR';},2800);}});
  root.querySelector('[data-signout]').addEventListener('click',async()=>{try{await call('/auth/logout',{method:'POST'});}catch{}localStorage.removeItem(sessionKey);session='';renderSignedOut();loadLeaderboard();announce('Signed out. Your Hat Bucks remain attached to your Shop account.');});
  async function loadLeaderboard(){try{const data=await call('/leaderboard');const leaders=(data.leaders||[]).slice(0,session?data.leaders.length:10);leaderboardNode.innerHTML='';if(!leaders.length){leaderboardNode.innerHTML='<p class="ht-otb__empty">The grandstand is empty. Somebody be first to make a questionable decision.</p>';}else{leaderboardNode.insertAdjacentHTML('beforeend','<div class="ht-leaderboard__row ht-leaderboard__row--head"><span>RK</span><span>RUNNER</span><span>HAT BUCKS</span><span data-col="correct">CORRECT</span><span data-col="settled">SETTLED</span></div>');leaders.forEach(row=>leaderboardNode.insertAdjacentHTML('beforeend',`<div class="ht-leaderboard__row"><b>${row.rank}</b><strong>${escapeHtml(row.nickname)}</strong><b>${Number(row.balance).toLocaleString()}</b><span data-col="correct">${row.correctPicks}</span><span data-col="settled">${row.settledPicks}</span></div>`));}myRankNode.hidden=!(session&&data.me);if(session&&data.me)myRankNode.innerHTML=`YOUR POSITION: <strong>#${data.me.rank} ${escapeHtml(data.me.nickname)}</strong> · ${Number(data.me.balance).toLocaleString()} HAT BUCKS`; }catch(error){leaderboardNode.innerHTML=`<p class="ht-otb__error">${escapeHtml(error.message)}</p>`;}}
  function updateCountdown(){const remaining=Math.max(0,Date.parse('2026-09-29T04:59:59.999Z')-Date.now());const days=Math.floor(remaining/864e5),hours=Math.floor(remaining%864e5/36e5),minutes=Math.floor(remaining%36e5/6e4);root.querySelector('[data-race-countdown]').textContent=remaining?`${days} DAYS · ${hours} HRS · ${minutes} MIN`:'THE WINDOW IS CLOSED';}
  function shiftDate(days){const date=new Date(`${dateInput.value}T12:00:00Z`);date.setUTCDate(date.getUTCDate()+days);dateInput.value=date.toISOString().slice(0,10);loadGames();}
  function escapeHtml(value){const div=document.createElement('div');div.textContent=String(value??'');return div.innerHTML;}
  dateInput.addEventListener('change',loadGames);root.querySelectorAll('[data-date-shift]').forEach(button=>button.addEventListener('click',()=>shiftDate(Number(button.dataset.dateShift))));root.querySelector('[data-today]').addEventListener('click',()=>{dateInput.value=chicagoToday();loadGames();});refreshButton.addEventListener('click',loadGames);filters.addEventListener('click',event=>{const button=event.target.closest('[data-filter]');if(!button)return;activeFilter=button.dataset.filter;applyFilter();announce(`Showing ${activeFilter} games for ${dateInput.value}.`);});
  reviewConfirm.addEventListener('click',confirmReviewedPick);review.addEventListener('close',()=>{if(review.returnValue==='edit')reviewTrigger?.focus();pendingReview=null;reviewTrigger?.focus();});review.addEventListener('cancel',()=>{pendingReview=null;});
  mobileBar.addEventListener('click',()=>{const open=!picksDrawer.classList.contains('is-mobile-open');picksDrawer.classList.toggle('is-mobile-open',open);picksPanel.open=true;mobileBar.setAttribute('aria-expanded',String(open));if(open)picksPanel.querySelector('summary')?.focus();});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&picksDrawer.classList.contains('is-mobile-open')){closeMobilePicks();mobileBar.focus();}});
  const refreshBoard=()=>{const today=chicagoToday();if(today!==lastChicagoDay){const wasToday=dateInput.value===lastChicagoDay;lastChicagoDay=today;if(wasToday)dateInput.value=today;loadState();loadLeaderboard();}if(!document.hidden&&session)loadGames({silent:true});};document.addEventListener('visibilitychange',()=>{if(!document.hidden)refreshBoard();});(async()=>{await exchangeFragment();await loadState();await loadGames();loadLeaderboard();updateCountdown();})();setInterval(refreshBoard,30000);setInterval(updateCountdown,60000);
})();
</script>

