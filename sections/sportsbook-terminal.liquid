{%- assign ht_pickem_endpoint = section.settings.worker_url | default: 'https://hat-trick-sportsbook.bronson-16e.workers.dev' -%}
<section class="ht-otb" data-ht-otb data-endpoint="{{ ht_pickem_endpoint | escape }}" data-theme-id="{{ theme.id }}" data-theme-role="{{ theme.role | escape }}">
  <div class="ht-otb__ticker" aria-hidden="true"><div class="ht-otb__ticker-track"><span>RACE TO OCTOBER PICK ’EM&nbsp;&nbsp;◆&nbsp;&nbsp;FREE TO PLAY&nbsp;&nbsp;◆&nbsp;&nbsp;HAT BUCKS ONLY&nbsp;&nbsp;◆&nbsp;&nbsp;PICKS CLOSE AT FIRST PITCH&nbsp;&nbsp;◆&nbsp;&nbsp;</span><span>RACE TO OCTOBER PICK ’EM&nbsp;&nbsp;◆&nbsp;&nbsp;FREE TO PLAY&nbsp;&nbsp;◆&nbsp;&nbsp;HAT BUCKS ONLY&nbsp;&nbsp;◆&nbsp;&nbsp;PICKS CLOSE AT FIRST PITCH&nbsp;&nbsp;◆&nbsp;&nbsp;</span></div></div>
  <header class="ht-otb__hero">
    <p class="ht-otb__eyebrow">HAT TRICK PICK ’EM · PENNANT WINDOW 01</p>
    <h1>RACE TO<br><em>OCTOBER.</em></h1>
    <div class="ht-otb__cert">FREE<br>BASEBALL<br>PICK ’EM</div>
    <p>Pick winners. Stack fictional Hat Bucks. Finish atop the board before postseason first pitch and collaborate with Hat Trick on exactly one personal, one-of-one custom hat.</p>
  </header>

  <section class="ht-race-clock" aria-label="Race to October deadline">
    <div><span>THE WINDOW CLOSES</span><strong>SEPTEMBER 28 · 11:59 PM CT</strong></div>
    <output data-race-countdown>CALCULATING THE PENNANT RACE…</output>
    <div><span>GRAND PRIZE</span><strong>ONE COLLABORATIVE DESIGN EXPERIENCE + EXACTLY ONE PERSONAL CUSTOM HAT · NO PRODUCTION RUN · ARV $39.99</strong></div>
  </section>

  <div class="ht-otb__disclosure"><strong>FREE BASEBALL PREDICTION CONTEST. NO PURCHASE NECESSARY.</strong> Hat Bucks are fictional points with no cash, purchase, discount, credit, or redemption value. A purchase will not improve your ranking, scoring, eligibility, or chance of winning. US residents age 21+; void where prohibited. Scores may be delayed. City labels and standard abbreviations identify publicly played games only. Shared cities use AL/NL labels for clarity. Not sponsored, endorsed, administered by, or associated with MLB or its clubs. <a href="/pages/race-to-october-pick-em-official-rules">READ THE OFFICIAL RULES →</a></div>

  <div class="ht-otb__desk">
    <aside class="ht-otb__account">
      <div data-signed-out>
        <p class="ht-otb__label">WINDOW ACCESS</p>
        <h2>CLUBHOUSE CHECK-IN</h2>
        <p>Preview the top ten below. Continue with Shop to open the game board, make picks, and keep one Hat Bucks balance across devices.</p>
        <a class="ht-otb__login" data-login href="#">CONTINUE WITH SHOP ↗</a>
      </div>
      <div data-signed-in hidden>
        <p class="ht-otb__label">AVAILABLE BALANCE</p>
        <output class="ht-otb__balance" data-balance>1,000</output>
        <span>FICTIONAL PICK ’EM POINTS · NO CASH VALUE</span>
        <p class="ht-otb__identity"><strong data-player-name>UNNAMED RUNNER</strong><span data-player-rank></span></p>
        <div class="ht-otb__refill" data-refill hidden>
          <strong>DAILY CLUBHOUSE REFILL AVAILABLE</strong>
          <p>Below 25? Restore your balance to 25 Hat Bucks. Free once per Chicago calendar day.</p>
          <button type="button" data-refill-button>CLAIM 25-POINT FLOOR</button>
        </div>
        <button type="button" class="ht-otb__signout" data-signout>SIGN OUT</button>
      </div>
      <form class="ht-otb__profile" data-profile hidden>
        <label for="ht-race-name">PUBLIC RACE NAME</label>
        <input id="ht-race-name" name="nickname" minlength="3" maxlength="18" pattern="[A-Za-z0-9 _-]+" autocomplete="off" required>
        <button type="submit">CLAIM SCOREBOARD NAME</button>
        <small>3–18 characters. Changeable once every 30 days.</small>
      </form>
      <form class="ht-otb__eligibility" data-eligibility hidden>
        <p class="ht-otb__label">ENTRY ELIGIBILITY</p>
        <label><input type="checkbox" name="confirmed" required> <span>I confirm that I am 21 or older, a legal resident of the 50 United States or D.C., and agree to the <a href="/pages/race-to-october-pick-em-official-rules">Official Rules</a> and <a href="/policies/privacy-policy">Privacy Policy</a>.</span></label>
        <button type="submit">CONFIRM &amp; ENTER PICK ’EM</button>
        <small>Your confirmation is recorded with your verified Shop account. The provisional winner must verify eligibility before receiving the prize.</small>
      </form>
    </aside>

    <main class="ht-otb__board">
      <div class="ht-otb__board-head">
        <div><p class="ht-otb__label">TODAY'S ACTION</p><h2>BASEBALL BOARD</h2></div>
        <div class="ht-board-nav" data-board-nav hidden>
          <div class="ht-board-nav__dates" aria-label="Scoreboard date navigation">
            <button type="button" data-date-shift="-1" aria-label="Previous day">←</button>
            <button type="button" data-today>TODAY</button>
            <label>DATE <input type="date" data-date></label>
            <button type="button" data-date-shift="1" aria-label="Next day">→</button>
            <button type="button" data-refresh>REFRESH</button>
          </div>
          <div class="ht-board-nav__filters" data-filters aria-label="Filter games by status">
            <button type="button" data-filter="all">ALL</button>
            <button type="button" data-filter="open" aria-pressed="true" class="is-active">OPEN</button>
            <button type="button" data-filter="live">LIVE</button>
            <button type="button" data-filter="final">FINAL</button>
          </div>
        </div>
      </div>
      <p class="ht-otb__status" data-status role="status" aria-live="polite">Loading today’s Pick ’Em board…</p>
      <div class="ht-otb__games" data-games></div>
    </main>

    <aside class="ht-otb__slips" id="ht-mobile-picks" data-picks-drawer hidden>
      <details class="ht-picks-panel" data-picks-panel open>
        <summary><span>YOUR PICKS</span><b data-active-count>0 ACTIVE</b></summary>
        <div class="ht-pick-record" data-pick-record>NO SETTLED PICKS YET</div>
        <div data-tickets><p class="ht-otb__empty">No paper trail yet.</p></div>
      </details>
    </aside>
  </div>

  <section class="ht-leaderboard" data-leaderboard-section>
    <header><div><p class="ht-otb__label">OFFICIAL PENNANT BOARD</p><h2>RACE TO OCTOBER STANDINGS</h2></div><p>Ranked by Hat Bucks, correct settled picks, then earliest verified account join time. The provisional winner must complete verification under the <a href="/pages/race-to-october-pick-em-official-rules">Official Rules</a>.</p></header>
    <div class="ht-leaderboard__me" data-my-rank hidden></div>
    <div class="ht-leaderboard__rows" data-leaderboard><p class="ht-otb__empty">The grandstand is empty. Somebody be first to make a questionable decision.</p></div>
  </section>

  <template data-game-template>
    <article class="ht-game">
      <div class="ht-game__top"><span data-game-status></span><time data-game-time></time></div>
      <div class="ht-game__result" data-pick-result hidden aria-live="polite"></div>
      <div class="ht-game__teams">
        <div data-team="away"><b data-away-abbr></b><span data-away-name></span><small data-away-record></small></div><output data-away-score>–</output>
        <div data-team="home"><b data-home-abbr></b><span data-home-name></span><small data-home-record></small></div><output data-home-score>–</output>
      </div>
      <div class="ht-game__markets" data-markets>
        <fieldset><legend>WINNER</legend><button type="button" data-pick="away"></button><button type="button" data-pick="home"></button></fieldset>
        <div class="ht-game__stake"><span>RISK</span><button type="button" data-stake="25">25</button><button type="button" data-stake="50">50</button><button type="button" data-stake="100">100</button><button type="button" data-stake="ALL_IN">ALL IN</button></div>
        <button type="button" class="ht-game__submit" data-submit disabled>REVIEW PICK</button>
      </div>
    </article>
  </template>

  <dialog class="ht-review" data-review aria-labelledby="ht-review-title">
    <form method="dialog" class="ht-review__sheet">
      <div class="ht-review__head"><p class="ht-otb__label">FINAL CHECK</p><button type="submit" value="cancel" data-review-close aria-label="Close pick review">×</button></div>
      <h2 id="ht-review-title">REVIEW YOUR PICK</h2>
      <dl data-review-summary></dl>
      <p class="ht-review__warning">Picks become final when confirmed and close at first pitch. The worker’s accepted quote is authoritative.</p>
      <p class="ht-review__error" data-review-error role="alert" hidden></p>
      <div class="ht-review__actions">
        <button type="submit" value="edit" data-review-edit>EDIT PICK</button>
        <button type="submit" value="cancel">CANCEL</button>
        <button type="button" data-review-confirm>CONFIRM PICK</button>
      </div>
    </form>
  </dialog>

  <button type="button" class="ht-mobile-bar" data-mobile-bar hidden aria-controls="ht-mobile-picks" aria-expanded="false">
    <span><small>HAT BUCKS</small><b data-mobile-balance>—</b></span>
    <span><small>YOUR PICKS</small><b data-mobile-active>0 ACTIVE</b></span>
  </button>
</section>

<style>
  .ht-otb{--ink:#10130f;--cream:#efe2b8;--red:#bb2d22;--green:#173f31;--lime:#d5f632;--amber:#f1b72b;color:var(--cream);background-color:#172217;background-image:radial-gradient(#8c714e 1px,transparent 1px),radial-gradient(#263b25 1px,transparent 1px);background-position:0 0,6px 6px;background-size:12px 12px;font-family:Courier New,monospace;overflow:hidden}.ht-otb *{box-sizing:border-box}.ht-otb button,.ht-otb input{font:inherit}.ht-otb__ticker{overflow:hidden;border-block:4px solid var(--ink);background:var(--amber);color:var(--ink);font-weight:900;white-space:nowrap}.ht-otb__ticker span{display:inline-block;padding:.8rem 0;animation:otbTicker 22s linear infinite}.ht-otb__hero{position:relative;max-width:1500px;margin:auto;padding:clamp(4rem,7vw,9rem) clamp(2rem,6vw,8rem);background:linear-gradient(100deg,rgba(0,0,0,.94),rgba(17,58,35,.82));border-inline:4px solid var(--ink)}.ht-otb__eyebrow,.ht-otb__label{margin:0 0 1rem;color:var(--lime);font-weight:900;letter-spacing:.18em;font-size:1.2rem}.ht-otb__hero h1{margin:0;max-width:1050px;font-family:Impact,Haettenschweiler,sans-serif;font-size:clamp(6rem,12vw,16rem);font-weight:900;line-height:.82;letter-spacing:.01em}.ht-otb__hero h1 em{color:var(--red);font-style:normal;text-shadow:5px 5px 0 var(--amber)}.ht-otb__hero>p:last-child{max-width:720px;margin:3rem 0 0;font-size:clamp(1.6rem,2vw,2.2rem);line-height:1.45}.ht-otb__cert{position:absolute;right:6%;top:15%;display:grid;place-items:center;width:170px;aspect-ratio:1;border:4px double var(--amber);border-radius:50%;color:var(--amber);font-weight:900;text-align:center;transform:rotate(8deg)}.ht-otb__disclosure{padding:1.2rem 5vw;border-block:3px solid var(--ink);background:#eadcb2;color:var(--ink);font-size:1.1rem;line-height:1.45}.ht-otb__desk{display:grid;grid-template-columns:minmax(230px,300px) minmax(0,1fr) minmax(260px,330px);gap:2rem;max-width:1500px;margin:auto;padding:3rem 2rem 7rem}.ht-otb__account,.ht-otb__board,.ht-otb__slips{border:4px solid var(--ink);box-shadow:8px 8px 0 #050805}.ht-otb__account,.ht-otb__slips{align-self:start;padding:2rem;background:#293c28}.ht-otb__balance{display:block;color:#ff482f;font-family:Impact,sans-serif;font-size:6rem;line-height:1;text-shadow:0 0 12px #ff351c}.ht-otb__refill{margin:1.5rem 0;padding:1rem;border:2px dashed var(--amber);background:#142319}.ht-otb__refill strong{display:block;color:var(--lime)}.ht-otb__refill button{width:100%;padding:1rem;border:3px solid var(--ink);background:var(--amber);color:var(--ink);font-weight:900}.ht-otb__board{background:#06130d}.ht-otb__board-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:2rem;border-bottom:3px solid var(--amber)}.ht-otb h2{margin:.2rem 0;font-family:Impact,sans-serif;font-size:3.5rem;letter-spacing:.03em}.ht-otb__board-head label{font-size:1.1rem}.ht-otb__board-head input{display:block;margin-top:.5rem;padding:.8rem;background:#111;color:var(--lime);border:2px solid var(--lime)}.ht-otb__status{margin:0;padding:1rem 2rem;border-bottom:2px solid #49604a;color:var(--lime)}.ht-otb__games{display:grid;gap:1.5rem;padding:1.5rem}.ht-game{border:3px solid #4b6b51;background:#101a12}.ht-game__top{display:flex;justify-content:space-between;padding:.8rem 1rem;background:#34452f;color:var(--lime);font-weight:900}.ht-game__teams{display:grid;grid-template-columns:1fr auto;gap:0;border-bottom:2px solid #4b6b51}.ht-game__teams>div{display:grid;grid-template-columns:4.5rem 1fr auto;align-items:center;gap:1rem;padding:1rem;border-bottom:1px solid #4b6b51}.ht-game__teams b{color:var(--amber);font-size:2rem}.ht-game__teams small{opacity:.7}.ht-game__teams output{min-width:4.5rem;padding:1rem;text-align:center;font-size:2.6rem;font-weight:900;border-left:2px solid #4b6b51}.ht-game__markets{padding:1rem}.ht-game fieldset{display:grid;grid-template-columns:auto 1fr 1fr;gap:.8rem;margin:0 0 1rem;padding:0;border:0}.ht-game legend{float:left;min-width:9rem;padding:.8rem;color:var(--amber);font-weight:900}.ht-game button{border:2px solid var(--cream);background:#15291d;color:var(--cream);font-weight:900}.ht-game fieldset button{padding:.8rem}.ht-game button.is-selected{background:var(--amber);color:var(--ink);box-shadow:3px 3px 0 var(--red)}.ht-game__stake{display:flex;align-items:center;gap:.6rem}.ht-game__stake span{margin-right:auto}.ht-game__stake button{padding:.7rem}.ht-game__submit{width:100%;margin-top:1rem;padding:1rem;background:var(--red)!important}.ht-game__submit:disabled{opacity:.35}.ht-game.is-locked .ht-game__markets{display:none}.ht-slip{position:relative;margin:1.5rem 0;padding:1.5rem 1rem;background:#ece4c7;color:#111;box-shadow:3px 4px 0 #000;transform:rotate(-1deg)}.ht-slip:after{content:"";position:absolute;inset:auto 0 -6px;height:12px;background:linear-gradient(135deg,transparent 6px,#ece4c7 0) 0 0/12px 12px}.ht-slip b,.ht-slip span{display:block}.ht-slip .won{color:#176128}.ht-slip .lost{color:#a21f18}.ht-otb__empty{opacity:.7}.ht-otb__error{padding:2rem;color:#ff6f5f}.ht-otb button:focus-visible,.ht-otb input:focus-visible{outline:4px solid var(--lime);outline-offset:3px}
  .ht-picks-panel>summary{display:flex;align-items:end;justify-content:space-between;gap:1rem;cursor:pointer;list-style:none}.ht-picks-panel>summary::-webkit-details-marker{display:none}.ht-picks-panel>summary span{font-family:Impact,sans-serif;font-size:3.2rem;line-height:.95}.ht-picks-panel>summary b{color:var(--lime);font-size:.85rem;white-space:nowrap}.ht-pick-record{margin:1.25rem 0;padding:.8rem;border-block:2px dashed #73806f;color:var(--amber);font-weight:900;line-height:1.4}.ht-ticket-group{margin-top:1.2rem}.ht-ticket-group>h3{margin:0;color:var(--lime);font-size:.8rem;letter-spacing:.14em}.ht-ticket-history{margin-top:1rem;border:2px dashed #73806f}.ht-ticket-history>summary{padding:.9rem;cursor:pointer;color:var(--cream);font-weight:900}.ht-ticket-history>div{padding:0 .8rem .3rem}.ht-otb summary:focus-visible{outline:4px solid var(--lime);outline-offset:3px}
  .ht-picks-panel>summary:after{content:'⌄';display:inline-grid;place-items:center;flex:0 0 auto;width:2rem;height:2rem;border:2px solid var(--lime);color:var(--lime);font:900 1.4rem/1 Arial,sans-serif;transition:transform .2s ease}.ht-picks-panel[open]>summary:after{transform:rotate(180deg)}
  .ht-otb__disclosure a,.ht-leaderboard a{color:inherit;font-weight:900;text-decoration-thickness:2px;text-underline-offset:3px}.ht-otb__board-head{flex-wrap:wrap;align-content:flex-start;row-gap:1.25rem}.ht-otb__board-head>div:first-child{flex:1 1 240px;min-width:0}.ht-otb__board-head h2{white-space:nowrap;word-break:normal;overflow-wrap:normal}.ht-board-nav{flex:1 1 560px;min-width:0;margin-left:auto}
  .ht-otb__score-gate{display:grid;gap:.8rem;min-height:260px;place-content:center;padding:2.5rem;border:3px dashed #4b6b51;background:#101a12;text-align:center}.ht-otb__score-gate strong{color:var(--amber);font-family:Impact,Haettenschweiler,sans-serif;font-size:clamp(2.6rem,5vw,4.8rem);line-height:.95;letter-spacing:.04em}.ht-otb__score-gate span{max-width:520px;color:var(--cream);font-size:1.2rem;line-height:1.45}
  .ht-board-nav{display:grid;gap:1rem;min-width:min(100%,560px)}.ht-board-nav__dates,.ht-board-nav__filters{display:flex;align-items:end;justify-content:flex-end;gap:.55rem;flex-wrap:wrap}.ht-board-nav button{min-height:3.6rem;padding:.7rem .85rem;border:2px solid var(--lime);background:#111;color:var(--lime);font-weight:900}.ht-board-nav button:hover,.ht-board-nav button.is-active{background:var(--lime);color:var(--ink)}.ht-board-nav__filters button{min-width:6rem}.ht-otb__status{display:flex;align-items:center;min-height:4.5rem}.ht-game[hidden]{display:none}.ht-otb__empty-state{padding:3rem 2rem;border:3px dashed #4b6b51;text-align:center}.ht-otb__skeleton{height:18rem;border:3px solid #4b6b51;background:linear-gradient(90deg,#101a12 25%,#243529 45%,#101a12 65%) 0 0/220% 100%;animation:htSkeleton 1.25s linear infinite}
  .ht-review{width:min(92vw,620px);max-width:none;padding:0;border:0;background:transparent;color:var(--cream)}.ht-review::backdrop{background:rgba(0,0,0,.78);backdrop-filter:blur(3px)}.ht-review__sheet{padding:2rem;border:4px solid var(--ink);background:#203622;box-shadow:10px 10px 0 var(--red)}.ht-review__head{display:flex;align-items:start;justify-content:space-between}.ht-review__head button{width:3rem;height:3rem;border:2px solid var(--cream);background:transparent;color:var(--cream);font-size:2rem}.ht-review h2{color:var(--amber)!important}.ht-review dl{display:grid;grid-template-columns:minmax(8rem,.7fr) 1.3fr;margin:1.5rem 0;border-block:2px dashed #73806f}.ht-review dt,.ht-review dd{margin:0;padding:.85rem 0;border-bottom:1px solid #526653}.ht-review dt{color:var(--amber);font-weight:900}.ht-review dd{text-align:right;font-weight:900}.ht-review__warning{line-height:1.5}.ht-review__error{padding:1rem;border:2px solid #ff6f5f;color:#ffb4ab}.ht-review__actions{display:grid;grid-template-columns:1fr 1fr 1.35fr;gap:.7rem;margin-top:1.5rem}.ht-review__actions button{min-height:4.6rem;padding:.8rem;border:2px solid var(--cream);background:#15291d;color:var(--cream);font-weight:900}.ht-review__actions [data-review-confirm]{border-color:var(--ink);background:var(--amber);color:var(--ink)}.ht-review__actions button:disabled{opacity:.45}.ht-mobile-bar{display:none}
  @keyframes htSkeleton{to{background-position:-220% 0}}
  .ht-game button.is-your-pick{position:relative;border-color:var(--lime);background:var(--amber);color:var(--ink);box-shadow:0 0 0 3px var(--ink),0 0 18px rgba(213,246,50,.75)}.ht-game button.is-your-pick:after{content:"YOUR PICK";position:absolute;z-index:2;right:-8px;top:-13px;padding:.35rem .55rem;border:2px solid var(--ink);background:var(--lime);color:var(--ink);font:900 .72rem/1 Arial,sans-serif;letter-spacing:.08em;white-space:nowrap;transform:rotate(3deg);animation:htPickGlow 1.8s ease-in-out infinite}
  .ht-game__teams>div.is-your-pick-team{position:relative;padding-bottom:1.8rem;background:rgba(213,246,50,.08);box-shadow:inset 6px 0 0 var(--lime)}.ht-game__teams>div.is-your-pick-team:after{content:"YOUR PICK";position:absolute;left:1rem;bottom:.32rem;padding:.25rem .5rem;border:2px solid var(--ink);background:var(--lime);color:var(--ink);font:900 .68rem/1 Arial,sans-serif;letter-spacing:.09em;white-space:nowrap;transform:rotate(-1deg);animation:htPickGlow 1.8s ease-in-out infinite}
  .ht-game__result{position:relative;z-index:3;margin:-1px 1rem 0;padding:.65rem 1rem;border:3px solid var(--ink);color:var(--ink);font:900 clamp(1.45rem,3vw,2.25rem)/1 Impact,Haettenschweiler,sans-serif;letter-spacing:.08em;text-align:center;transform:rotate(-.6deg);box-shadow:4px 4px 0 var(--ink);animation:htResultStamp .28s ease-out both}.ht-game__result.won{background:var(--lime)}.ht-game__result.lost{background:#ff5648;color:#fff}.ht-game.pick-result--won{border-color:var(--lime)}.ht-game.pick-result--lost{border-color:#ff5648}
  @keyframes htResultStamp{from{opacity:0;transform:rotate(-.6deg) scale(1.16)}to{opacity:1;transform:rotate(-.6deg) scale(1)}}
  @keyframes htPickGlow{50%{box-shadow:0 0 14px rgba(213,246,50,.95);transform:rotate(-2deg) scale(1.04)}}
  @keyframes otbTicker{to{transform:translateX(-50%)}}
  @media(max-width:1050px){.ht-otb__desk{grid-template-columns:240px 1fr}.ht-otb__slips{grid-column:1/-1}.ht-otb__cert{display:none}}
  @media(min-width:750px) and (max-width:1150px){.ht-otb__desk{grid-template-columns:210px minmax(0,1fr);gap:1rem;padding-inline:1rem}.ht-otb__account,.ht-otb__slips{padding:1.25rem}.ht-otb__board{min-width:0}.ht-otb__board-head{align-items:start;flex-direction:column;gap:1rem;padding:1.25rem}.ht-otb__board-head>div:first-child{min-width:0}.ht-otb__board-head h2{white-space:nowrap;word-break:normal;overflow-wrap:normal}.ht-board-nav{width:100%;min-width:0}.ht-board-nav__dates,.ht-board-nav__filters{justify-content:flex-start}.ht-otb h2{font-size:clamp(2.4rem,5vw,3.5rem)}.ht-game__teams>div{grid-template-columns:3.5rem minmax(0,1fr) auto;gap:.6rem}.ht-game__teams b{font-size:1.5rem}.ht-game__teams output{min-width:3.5rem;padding:.7rem;font-size:2rem}.ht-game fieldset{grid-template-columns:7rem minmax(0,1fr) minmax(0,1fr)}.ht-game legend{min-width:0;padding:.6rem}.ht-game button{min-width:0}.ht-picks-panel>summary span{font-size:2.6rem}}
