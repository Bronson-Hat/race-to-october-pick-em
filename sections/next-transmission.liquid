<section class="ht-signal" data-ht-signal>
  <div class="ht-signal__static" aria-hidden="true"></div>
  <div class="ht-signal__eyebrow"><span>Hat Trick late-night programming</span><i></i><span>Transmission no. 01</span></div>

  <div class="ht-signal__stage">
    <div class="ht-signal__backroom">
      <div class="ht-signal__halo" aria-hidden="true"></div>
      <img class="ht-signal__photo" src="{{ 'ht-supersonics-next.jpg' | asset_url }}" width="1538" height="2048" loading="lazy" alt="A camouflage Super Sonics hat emerging through fog">
      <div class="ht-signal__copy">
        <p class="ht-signal__code">A strange new arrival · Pacific Northwest</p>
        <h2 class="ht-signal__title"><span>THE NEXT ONE</span><span>IS ALREADY HERE</span></h2>
        <p class="ht-signal__sub">Something is moving through the trees.<br>New Hat Trick programming begins soon.</p>
        <button class="ht-signal__button" type="button" data-ht-get-signal><span>Get the signal</span><b>↗</b></button>
      </div>
    </div>

    <div class="ht-signal__floor" aria-hidden="true"></div>
    <div class="ht-signal__curtain ht-signal__curtain--left" aria-hidden="true"><i></i></div>
    <div class="ht-signal__curtain ht-signal__curtain--right" aria-hidden="true"><i></i></div>
    <div class="ht-signal__valance" aria-hidden="true"></div>
  </div>

  <div class="ht-signal__footer" aria-hidden="true"><span>COMING SOON</span><span>◆</span><span>DAMN FINE CAP</span><span>◆</span><span>COMING SOON</span></div>
</section>

<style>
  .ht-signal{--red:#861c24;--red-dark:#37070b;--cream:#f2e8c9;--acid:#b9ff31;position:relative;overflow:hidden;background:#0a0808;color:var(--cream);border-block:6px solid #111;font-family:Arial,sans-serif;isolation:isolate}
  .ht-signal__eyebrow,.ht-signal__footer{position:relative;z-index:12;display:flex;align-items:center;justify-content:center;gap:24px;padding:14px 24px;background:#111;color:#f4e7c2;font:800 11px/1.1 Arial,sans-serif;letter-spacing:.2em;text-transform:uppercase}
  .ht-signal__eyebrow i{width:42px;height:1px;background:#a42a32}
  .ht-signal__stage{position:relative;height:min(78vw,860px);min-height:610px;overflow:hidden;background:#050505;perspective:900px}
  .ht-signal__backroom{position:absolute;inset:0 8%;overflow:hidden;background:radial-gradient(circle at 50% 38%,#33161d 0,#10090c 45%,#020202 76%);box-shadow:inset 0 0 120px #000}
  .ht-signal__photo{position:absolute;z-index:2;left:50%;top:43%;width:min(44vw,560px);height:auto;transform:translate(-50%,-49%) scale(.9);opacity:.15;filter:saturate(.72) contrast(1.16) brightness(.72);-webkit-mask-image:radial-gradient(ellipse 52% 46% at 50% 42%,#000 25%,rgba(0,0,0,.95) 50%,transparent 78%);mask-image:radial-gradient(ellipse 52% 46% at 50% 42%,#000 25%,rgba(0,0,0,.95) 50%,transparent 78%);transition:transform 1.8s cubic-bezier(.18,.75,.12,1),opacity 1.6s ease,filter 1.6s ease}
  .ht-signal.is-visible .ht-signal__photo{transform:translate(-50%,-53%) scale(1);opacity:.96;filter:saturate(.82) contrast(1.1) brightness(.8)}
  .ht-signal__halo{position:absolute;z-index:1;left:50%;top:35%;width:50%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(185,255,49,.14),transparent 63%);filter:blur(22px);animation:htHalo 5.2s ease-in-out infinite}
  .ht-signal__copy{position:absolute;z-index:6;left:50%;bottom:12%;width:min(760px,70%);transform:translateX(-50%);text-align:center;text-shadow:0 3px 18px #000,0 0 45px #000}
  .ht-signal__code{margin:0 0 14px;color:#b8ff45;font:800 11px/1.3 monospace;letter-spacing:.22em;text-transform:uppercase}
  .ht-signal__title{position:relative;margin:0;color:var(--cream);font:900 clamp(54px,7.8vw,124px)/.76 Impact,'Arial Narrow',sans-serif;letter-spacing:-.025em;text-transform:uppercase;-webkit-text-stroke:1.5px #f4edda;filter:drop-shadow(0 4px 0 #000) drop-shadow(0 0 18px #000)}
  .ht-signal__title span{display:block;position:relative;background:none;-webkit-text-fill-color:var(--cream);color:var(--cream);text-shadow:0 8px 16px #000}
  .ht-signal__title span:first-child{z-index:0;background:linear-gradient(180deg,var(--cream) 0 55%,#807665 82%,#332e29 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
  .ht-signal__title span+span{z-index:2;margin-top:-.02em}
  .ht-signal.is-visible .ht-signal__title{animation:htTitleGlitch 4.4s 1.1s infinite}
  .ht-signal__sub{margin:22px auto 24px;max-width:560px;color:var(--cream)!important;font:700 clamp(14px,1.4vw,18px)/1.5 Arial,sans-serif;letter-spacing:.03em}
  .ht-signal__button{display:inline-flex;align-items:center;gap:42px;padding:15px 18px 15px 22px;border:2px solid var(--cream);background:rgba(5,5,5,.8);color:var(--cream);box-shadow:5px 5px 0 #98232b;cursor:pointer;font:900 12px/1 Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;transition:.2s ease}
  .ht-signal__button:hover{color:#111;background:var(--acid);border-color:#111;box-shadow:8px 8px 0 #98232b;transform:translate(-2px,-2px)}
  .ht-signal__button b{font-size:18px}
  .ht-signal__floor{display:none}
  .ht-signal__curtain{position:absolute;z-index:8;top:0;bottom:0;width:49%;background:repeating-linear-gradient(90deg,#3b070b 0,#8f1d26 8%,#c03a42 14%,#6a1018 22%,#2d0407 28%);box-shadow:inset 0 0 85px #250205,0 0 48px #000;transition:transform 2.1s cubic-bezier(.22,.76,.12,1)}
  .ht-signal__curtain:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.08),transparent);mix-blend-mode:screen}
  .ht-signal__curtain i{display:none}
  .ht-signal__curtain--left{left:-8%;border-right:5px solid #220306;transform:translateX(0) skewX(-1deg)}.ht-signal__curtain--left i{right:-13px}
  .ht-signal__curtain--right{right:-8%;border-left:5px solid #220306;transform:translateX(0) skewX(1deg)}.ht-signal__curtain--right i{left:-13px}
  .ht-signal.is-visible .ht-signal__curtain--left{transform:translateX(-52%) skewX(-2deg)}.ht-signal.is-visible .ht-signal__curtain--right{transform:translateX(52%) skewX(2deg)}
  .ht-signal__valance{position:absolute;z-index:10;left:-2%;right:-2%;top:-65px;height:180px;border-radius:0 0 50% 50%;background:repeating-linear-gradient(90deg,#45080d 0,#aa2932 9%,#661018 16%,#2c0408 23%);box-shadow:0 20px 40px #000,inset 0 -15px 25px rgba(0,0,0,.65)}
  .ht-signal__static{position:absolute;z-index:11;inset:0;pointer-events:none;opacity:.11;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");animation:htNoise .24s steps(2) infinite}
  .ht-signal__footer{justify-content:space-around;background:#99232c;color:#fff}
  @keyframes htHalo{50%{opacity:.55;transform:translate(-50%,-50%) scale(1.12)}}
  @keyframes htNoise{0%{transform:translate(0)}25%{transform:translate(-1%,1%)}50%{transform:translate(1%,-1%)}75%{transform:translate(.5%,1%)}}
  @keyframes htTitleGlitch{0%,66%,72%,78%,100%{transform:translate(0);filter:drop-shadow(0 4px 0 #000) drop-shadow(0 0 18px #000)}67%{transform:translate(-5px,1px) skewX(-1deg);filter:drop-shadow(9px 0 #ff2945) drop-shadow(-9px 0 #64ff96) drop-shadow(0 6px 12px #000)}68%{transform:translate(5px,-2px);filter:drop-shadow(-11px 0 #ff2945) drop-shadow(11px 0 #64ff96) drop-shadow(0 6px 12px #000)}69%{transform:translate(-2px,1px);filter:drop-shadow(7px 0 #ff2945) drop-shadow(-7px 0 #64ff96) drop-shadow(0 6px 12px #000)}73%{transform:translate(6px,0) scaleX(1.015);filter:drop-shadow(-10px 0 #ff2945) drop-shadow(9px 0 #64ff96) drop-shadow(0 6px 12px #000)}74%{transform:translate(-5px,2px);filter:drop-shadow(10px 0 #ff2945) drop-shadow(-10px 0 #64ff96) drop-shadow(0 6px 12px #000)}75%{transform:translate(0);filter:drop-shadow(0 4px 0 #000) drop-shadow(0 0 18px #000)}}
  @keyframes htFloorSignal{0%,66%,72%,78%,100%{background-position:42px 0,42px 0,0 0,0 0;filter:brightness(.72)}67%{background-position:42px 13px,42px 13px,0 13px,0 13px;filter:brightness(.95)}69%{background-position:42px -6px,42px -6px,0 -6px,0 -6px;filter:brightness(.78)}73%{background-position:42px 18px,42px 18px,0 18px,0 18px;filter:brightness(1)}75%{background-position:42px 0,42px 0,0 0,0 0;filter:brightness(.72)}}
  @media(max-width:749px){.ht-signal__eyebrow span:last-child{display:none}.ht-signal__stage{height:760px;min-height:0}.ht-signal__backroom{inset:0}.ht-signal__photo{top:39%;width:92vw}.ht-signal__copy{bottom:8%;width:66%}.ht-signal__title{font-size:clamp(40px,12vw,54px);line-height:.84;letter-spacing:-.015em}.ht-signal__title span{white-space:normal;text-shadow:0 7px 13px #000}.ht-signal__title span+span{margin-top:-.01em}.ht-signal__sub{font-size:13px;line-height:1.4}.ht-signal__sub br{display:none}.ht-signal__curtain{width:59%}.ht-signal.is-visible .ht-signal__curtain--left{transform:translateX(-58%)}.ht-signal.is-visible .ht-signal__curtain--right{transform:translateX(58%)}.ht-signal__valance{height:145px}.ht-signal__footer span:nth-child(n+4){display:none}}
  @media(prefers-reduced-motion:reduce){.ht-signal *{animation:none!important;transition:none!important}.ht-signal__curtain--left{transform:translateX(-52%)}.ht-signal__curtain--right{transform:translateX(52%)}.ht-signal__photo{opacity:.96;transform:translate(-50%,-53%)}}
</style>

<script>
  (()=>{const root=document.querySelector('[data-ht-signal]:not([data-ht-ready])');if(!root)return;root.setAttribute('data-ht-ready','');const reveal=()=>root.classList.add('is-visible');if('IntersectionObserver'in window){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){reveal();io.disconnect()}}),{threshold:.18});io.observe(root)}else reveal();root.querySelector('[data-ht-get-signal]')?.addEventListener('click',()=>{const email=document.querySelector('.footer input[type="email"],footer input[type="email"]');if(email){email.scrollIntoView({behavior:'smooth',block:'center'});setTimeout(()=>email.focus({preventScroll:true}),650)}else location.href='/pages/contact-us'})})();
</script>

{% schema %}
{"name":"Next transmission","settings":[],"presets":[{"name":"Next transmission"}]}
{% endschema %}
